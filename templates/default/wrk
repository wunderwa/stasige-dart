#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

usage() {
  cat <<USG
Usage:
  ./wrk -b [-D] [-S] [-J] [-H] [-I] [-C] [-s]
  ./wrk -C
  ./wrk -s [-D]
Options:
  -s  local server (with -b: start after build)
  -b  build
  -D  dev (dev/, timekey=dev)
  -S  css only
  -J  js only (esbuild)
  -H  html only
  -I  img only (svg/webp)
  -C  clear target before build (or alone)
  -h  help
USG
}

BUILD=0; DEV=0; CSS=0; JS=0; HTML=0; IMG=0; CLEAR=0; SRV=0
FILLED=''

while getopts "sbDSJHICh" opt; do
  case $opt in
    s) SRV=1; FILLED=1 ;;
    b) BUILD=1; FILLED=1 ;;
    D) DEV=1;   FILLED=1 ;;
    S) CSS=1;   FILLED=1 ;;
    J) JS=1;    FILLED=1 ;;
    H) HTML=1;  FILLED=1 ;;
    I) IMG=1;   FILLED=1 ;;
    C) CLEAR=1; FILLED=1 ;;
    h) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done

[ -z "$FILLED" ] && [ "$SRV" = "0" ] && { usage; exit 1; }

TARGET=dist
[ "$DEV" = "1" ] && TARGET=dev

if [ "$SRV" = "1" ] && [ "$BUILD" = "0" ]; then
  python3 -m http.server -d "$TARGET" 8000
  exit 0
fi

if [ "$CLEAR" = "1" ]; then
  echo "clear: $TARGET"
  rm -rf "$TARGET"
  [ "$BUILD" = "0" ] && exit 0
fi

[ "$BUILD" = "0" ] && exit 0

DART_ARGS=(build)
[ "$DEV" = "1" ]  && DART_ARGS+=(--dev)
[ "$CSS" = "1" ]  && DART_ARGS+=(--css)
[ "$JS" = "1" ]   && DART_ARGS+=(--js)
[ "$HTML" = "1" ] && DART_ARGS+=(--html)
[ "$IMG" = "1" ]  && DART_ARGS+=(--img)

echo "wrk: dart run bin/wrk.dart ${DART_ARGS[*]}"
dart run bin/wrk.dart "${DART_ARGS[@]}"

if [ "$SRV" = "1" ]; then
  python3 -m http.server -d "$TARGET" 8000
fi
