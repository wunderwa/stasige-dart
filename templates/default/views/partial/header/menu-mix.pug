mixin navItem(item, path)
  if item.children
    li.nav-item.dropdown
      a.nav-link.dropdown-toggle(href="#" role='button' data-bs-toggle='dropdown' aria-expanded='false')= item.menuShort || item.menuLong || item.title
      ul.dropdown-menu
        li
          a.dropdown-item(href=item.path)= item.menuLong || item.menuShort || item.title
        each child in item.children
          li
            a.dropdown-item(href=child.path)= child.menuLong || child.menuShort || child.title
  else
    li.nav-item
      a.nav-link(href=item.path)= item.menuShort || item.menuLong || item.title
